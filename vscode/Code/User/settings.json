{
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[nginx]": {
        "editor.defaultFormatter": "raynigon.nginx-formatter"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "a-file-icon-vscode.activeIconPacks": [
        "angular",
        "rails",
        "python"
    ],
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },
    "atomKeymap.promptV3Features": true,
    "black-formatter.importStrategy": "fromEnvironment",
    "coloredRegions.namedColors": {
        "exception": "rgba(150, 20, 20, 0.2)",
        "marked_for_removal": "rgba(100, 20, 120, 0.2)",
        "packages": "rgba(0, 0, 100, 0.2)"
    },
    "continue.enableTabAutocomplete": false,
    "continue.pauseCodebaseIndexOnStart": true,
    "continue.pauseTabAutocompleteOnBattery": true,
    "continue.telemetryEnabled": false,
    "debug.inlineValues": "on",
    "docker.containers.description": [
        "ContainerId",
        "Status"
    ],
    "docker.containers.label": "ContainerName",
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.fontFamily": "'MesloLGS NF', 'Courier New', monospace",
    "editor.fontLigatures": "calt",
    "editor.fontWeight": 400,
    "editor.formatOnPaste": true,
    "editor.inlineSuggest.enabled": true,
    "editor.largeFileOptimizations": false,
    "editor.minimap.autohide": true,
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fill",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.rulers": [
        80
    ],
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "function": "#00BCD4"
        }
    },
    "editor.suggest.localityBonus": true,
    "editor.suggest.preview": true,
    "editor.suggestSelection": "first",
    "editor.tokenColorCustomizations": {
        "[monokai-charcoal (yellow)]": {
            "functions": "#FF9900",
            "variables": "#80ceff"
        }
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "onFocusChange",
    "files.autoSaveWhenNoErrors": true,
    "files.autoSaveWorkspaceFilesOnly": true,
    "files.exclude": {
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.project": true,
        "**/.settings": true
    },
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "flake8.args": [
        "--max-line-length=999"
    ],
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "github.copilot.chat.localeOverride": "en",
    "github.copilot.chat.scopeSelection": true,
    "github.copilot.enable": {
        "*": true,
        "csv": false,
        "markdown": true,
        "plaintext": false,
        "python": true,
        "scminput": false
    },
    "gitlens.statusBar.enabled": false,
    "jupyter.askForKernelRestart": false,
    "jupyter.enableExtendedPythonKernelCompletions": true,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "latex-workshop.docker.enabled": true,
    "liveshare.increasedGuestLimit": false,
    "markdown.extension.syntax.plainTheme": true,
    "markdownlint.config": {
        "default": true,
        "no-inline-html": {
            "allowed_elements": [
                "pre",
                "summary",
                "details",
                "img",
                "table"
            ]
        },
        "ul-indent": {
            "indent": 4
        }
    },
    "mdb.confirmRunAll": false,
    "multiCommand.commands": [
        {
            "command": "multiCommand.chat_ui",
            "interval": 60,
            "sequence": [
                "simpleBrowser.show",
                {
                    "args": {
                        "text": "https://chat.hurricane.home/"
                    },
                    "command": "type"
                }
            ]
        }
    ],
    "notebook.cellFocusIndicator": "border",
    "notebook.output.scrolling": true,
    "pieces.automaticallyCopyLink": false,
    "powershell.debugging.createTemporaryIntegratedConsole": true,
    "python.createEnvironment.trigger": "off",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "redhat.telemetry.enabled": false,
    "settingsSync.ignoredExtensions": [
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-edgedevtools.vscode-edge-devtools"
    ],
    "settingsSync.ignoredSettings": [
        "editor.fontFamily",
        "terminal.external.linuxExec",
        "terminal.integrated.defaultProfile.linux",
        "terminal.integrated.fontSize",
        "workbench.preferredDarkColorTheme",
        "workbench.colorTheme",
        "-plantuml.render",
        "-plantuml.server"
    ],
    "task.problemMatchers.neverPrompt": {
        "shell": true
    },
    "telemetry.telemetryLevel": "off",
    "terminal.external.linuxExec": "/bin/zsh",
    "terminal.external.windowsExec": "powershell.exe",
    "terminal.integrated.allowMnemonics": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.linux": "",
    "terminal.integrated.detectLocale": "on",
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.lineHeight": 1.05,
    "terminal.integrated.mouseWheelZoom": true,
    "terminal.integrated.sendKeybindingsToShell": true,
    "terminal.integrated.smoothScrolling": true,
    "vscode-pets.theme": "beach",
    "vscode-pets.throwBallWithMouse": true,
    "window.commandCenter": false,
    "window.menuBarVisibility": "compact",
    "workbench.colorCustomizations": {
        "[Monokai]": {
            "terminal.background": "#1c1c19"
        },
        "[monokai-charcoal (yellow)]": {
            "activityBar.background": "#2c2c2c",
            "editorError.border": "#ff0000",
            "editorError.foreground": "#ff0000",
            "editorGroupHeader.tabsBackground": "#1a1a1a",
            "editorHoverWidget.background": "#0c0c0c",
            "editorHoverWidget.border": "#ffcc00",
            "editorWarning.border": "#00FF00",
            "editorWarning.foreground": "#00FF00",
            "gitlens.trailingLineForegroundColor": "#565656",
            "notebook.cellBorderColor": "#009dff",
            "notebook.cellEditorBackground": "#11181a",
            "notebook.cellHoverBackground": "#11181a",
            "notebook.outputContainerBackgroundColor": "#1c1c19",
            "notebook.outputContainerBorderColor": "#3eff45",
            "quickInput.background": "#2c2c2c",
            "sideBar.background": "#0c0c0c",
            "tab.activeBackground": "#2b2200",
            "tab.activeBorder": "#ffcc00",
            "tab.border": "#FFF",
            "terminal.background": "#1a1a1a"
        },
        "[semantic-rainbow]": {
            "editor.background": "#0b0b0d",
            "sideBar.background": "#11181a"
        }
    },
    "workbench.colorTheme": "monokai-charcoal (yellow)",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.wrapTabs": true,
    "workbench.editorAssociations": {
        "*.html": "default",
        "*.ipynb": "jupyter.notebook.ipynb",
        "*.p": "default",
        "*.xls": "mergeEditor.Input"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.layoutControl.enabled": false,
    "workbench.startupEditor": "newUntitledFile"
}
